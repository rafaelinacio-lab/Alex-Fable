# Nunca commitar .env real. Este arquivo é só um template.

# --- OpenAI (orquestrador) ---
OPENAI_API_KEY=
# Modelo usado no loop de function-calling. Padrão: gpt-4.1
OPENAI_MODEL=gpt-4.1
# Alguns modelos de raciocínio (ex: a série gpt-5.x — gpt-5.6-luna, gpt-5.4, etc.)
# recusam function calling em /v1/chat/completions com o erro:
#   "Function tools with reasoning_effort are not supported for <modelo> ...
#    To use function tools, use /v1/responses or set reasoning_effort to 'none'."
# Se você usar um desses modelos, defina esta variável (valores aceitos pela API:
# none | minimal | low | medium | high | xhigh | max). Para a maioria dos modelos
# (ex: gpt-4.1), deixe em branco/comentado — passar isso sem necessidade pode dar erro
# em modelos que não suportam o parâmetro.
# OPENAI_REASONING_EFFORT=none

# --- Dashboard web (acompanhamento ao vivo) ---
# Porta onde a página de observabilidade fica disponível (http://localhost:PORTA)
DASHBOARD_PORT=4590

# --- Movidesk ---
# Base pública documentada da API Movidesk.
MOVIDESK_BASE_URL=https://api.movidesk.com/public/v1
# Token de acesso da API Movidesk. Fica só no processo servidor, nunca chega ao modelo.
MOVIDESK_TOKEN=
# URL do tenant, usada para montar links de retorno ao usuário (ex: https://viasoft.movidesk.com)
MOVIDESK_TENANT_URL=https://viasoft.movidesk.com

# Alternativa: se as chamadas passam por um gateway interno em vez da API pública direto,
# defina GATEWAY_BASE_URL e GATEWAY_TOKEN e ajuste src/movidesk/client.ts para usá-los.
# GATEWAY_BASE_URL=
# GATEWAY_TOKEN=

# --- Stores (auditoria, idempotência, rate limit) ---
# Caminho de diretório onde os arquivos JSONL/JSON de auditoria e idempotência são gravados.
# Troque por um banco real (Postgres/Redis) em produção — isso aqui é o suficiente para
# desenvolvimento local e para não perder o contrato de "nunca repetir POST sem checar antes".
AUDIT_STORE_DIR=./data/audit
IDEMPOTENCY_STORE_DIR=./data/idempotency

# Limite de requisições por minuto contra a API Movidesk (ver seção 5 do prompt de sistema).
RATE_LIMIT_PER_MINUTE=10

# --- Exportação para Excel ---
# Diretório onde os arquivos .xlsx gerados por export_tickets_to_excel são gravados.
EXPORTS_DIR=./exports

# --- Diretórios locais (pessoas/organizações) ---
# Caminho para o JSON local que faz o papel da tabela `movidesk_contatos` (e-mail -> cod_ref).
# Troque por uma consulta real ao banco/planilha sincronizada quando existir.
LOCAL_CONTACTS_FILE=./data/local/movidesk_contatos.json
LOCAL_ORGANIZATIONS_FILE=./data/local/organizacoes.json
# Catálogo de serviços (id, nome, trilha hierárquica), exportado do Movidesk
# (Configurações > Serviços). Já vem preenchido com dados reais em data/local/servicos.json.
LOCAL_SERVICES_FILE=./data/local/servicos.json

# --- Automação de cobrança de retorno do cliente (proativa) ---
# Verifica periodicamente chamados em "Aguardando Retorno do Cliente"/"Aguardando
# Validação do Cliente" cuja última ação foi do OWNER (responsável) há tempo demais
# (contado em horas ÚTEIS, no calendário de SLA de CADA equipe) e publica uma cobrança
# automática no chamado. Ver src/agent/followUp.ts para a regra completa.
#
# A configuração por equipe (quais equipes, status monitorados, prazo, expediente/SLA,
# remetente) NÃO fica mais aqui — é feita pelo painel web, aba "Automação"
# (um perfil por equipe, para poder ter SLAs diferentes por equipe). Ver
# src/config/followUpProfiles.ts. Na primeira execução, um perfil é criado sozinho para
# "VIASOFT - Sistemas Internos" com os valores que eram fixos aqui antes desta feature.
#
# DESLIGADO por padrão de propósito: é uma automação que fala com clientes reais SEM
# revisão humana antes de publicar. Só ative com opt-in explícito — nenhum perfil roda
# de verdade enquanto esta variável não for "true", mesmo que esteja habilitado no painel.
FOLLOWUP_AUTOMATION_ENABLED=false
# Arquivo onde os perfis (equipe + regra de SLA) ficam salvos. Troque por um banco real
# em produção, mantendo o mesmo formato (ver src/config/followUpProfiles.ts).
# FOLLOWUP_PROFILES_FILE=./data/local/followup_profiles.json
# De quanto em quanto tempo (minutos) o agente confere se algum perfil já venceu o
# próprio intervalo de verificação e precisa rodar. Não precisa mexer nisso — cada
# perfil tem seu intervalo configurado no painel; isto só controla a granularidade da
# checagem (padrão 15min é fino o bastante para intervalos configurados em horas).
# FOLLOWUP_TICK_MINUTES=15

# --- Active Directory (busca de colaboradores Viasoft) ---
# Deixe em branco para usar o adapter mock (ver src/local/directory.ts) em desenvolvimento.
AD_URL=
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=
